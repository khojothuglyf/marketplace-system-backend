# Copy to .env and fill in real values before deploying.
# Secrets marked "required" make docker-compose fail fast if unset.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5433
APP_PORT=8080

# Long random string (>= 64 chars). Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-64-characters
JWT_EXPIRATION_MS=86400000

# Comma-separated frontend origins allowed to call the API.
# Example: https://shop.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500

ADMIN_INITIAL_EMAIL=admin@marketplace.com
ADMIN_INITIAL_PASSWORD=change-me-strong-admin-password
